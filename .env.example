APP_NAME=OculosVR Backend
APP_ENV=development
# Em qualquer ambiente que nao seja a sua maquina, use false.
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Banco local para desenvolvimento.
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=oculosvr_db

# Exemplo de string para MongoDB Atlas:
# MONGODB_URL=mongodb+srv://usuario:senha@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=oculosvr_db

# Nunca versione a chave real no repositorio. Fora de development a API nao sobe com a padrao.
# Gere uma chave: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_in_local_env
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
